package database

import (
	"context"
	"fmt"
	"os"
	"path/filepath"
	"strings"

	"github.com/oarkflow/squealx"
	"github.com/oarkflow/squealx/drivers/sqlite"
)

type User struct {
	ID string `db:"id" json:"id"`
	Name string `db:"name" json:"name"`
}

type Store struct {
	DB *squealx.DB
	Users squealx.Repository[User]
}

func Open(url string) (*Store, error) {
	if err := ensureSQLiteDirectory(url); err != nil {
		return nil, err
	}
	db, err := sqlite.Open(url, "app")
	if err != nil { return nil, fmt.Errorf("open database: %w", err) }
	return &Store{DB: db, Users: squealx.New[User](db, "users", "id")}, nil
}

func ensureSQLiteDirectory(databaseURL string) error {
	if strings.HasPrefix(databaseURL, "file:") {
		path := strings.TrimPrefix(databaseURL, "file:")
		path = strings.SplitN(path, "?", 2)[0]
		if path == "" || path == ":memory:" || strings.HasPrefix(path, "/") {
			return nil
		}
		if err := os.MkdirAll(filepath.Dir(path), 0o750); err != nil {
			return fmt.Errorf("create database directory: %w", err)
		}
	}
	return nil
}

func (s *Store) Close() error { return s.DB.Close() }

func (s *Store) Ping(ctx context.Context) error { return s.DB.PingContext(ctx) }
