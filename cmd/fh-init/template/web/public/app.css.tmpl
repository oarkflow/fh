:root { font-family: ui-sans-serif, system-ui, sans-serif; color: #172033; background: #edf2f7; }
body { margin: 0; min-height: 100vh; display: grid; place-items: center; }
main { width: min(42rem, calc(100% - 2rem)); padding: 2rem; background: white; border: 1px solid #d8e0ea; box-shadow: 0 1rem 3rem #26364a1a; }
form { display: grid; gap: .75rem; max-width: 20rem; } input, button { font: inherit; padding: .65rem .8rem; } button { cursor: pointer; } pre { white-space: pre-wrap; }
