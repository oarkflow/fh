const output = document.querySelector('#output');
const loginForm = document.querySelector('#login');
const accountControls = document.querySelector('#account-controls');
const profileButton = document.querySelector('#me');
const logoutButton = document.querySelector('#logout');
let secure;

const show = value => {
  output.textContent = JSON.stringify(value, null, 2);
};

const showAuthenticated = authenticated => {
  loginForm.hidden = authenticated;
  accountControls.hidden = !authenticated;
};

const startSecureSession = async () => {
  const configResponse = await fetch('/secure-config.json', {
    method: 'POST',
    credentials: 'same-origin',
    cache: 'no-store',
  });
  const config = await configResponse.json();
  if (!configResponse.ok) {
    throw new Error(config.detail || 'secure bootstrap failed');
  }

  const { createSecureFetch } = await import('/wasm/index.js');
  secure = await createSecureFetch({
    ...config,
    credentials: 'same-origin',
    clientBuild: 'fh-init-1',
    deviceName: 'Browser',
  });
  showAuthenticated(true);
  show(secure.sessionInfo());
};

loginForm.addEventListener('submit', async event => {
  event.preventDefault();
  const submitButton = loginForm.querySelector('button[type="submit"]');
  submitButton.disabled = true;

  try {
    const form = new FormData(loginForm);
    const response = await fetch('/auth/login', {
      method: 'POST',
      credentials: 'same-origin',
      headers: {'content-type': 'application/json'},
      body: JSON.stringify(Object.fromEntries(form)),
    });
    const result = await response.json();
    if (!response.ok) {
      throw new Error(result.detail || 'login failed');
    }

    showAuthenticated(true);
    await startSecureSession();
    loginForm.reset();
  } catch (error) {
    show({error: error instanceof Error ? error.message : String(error)});
  } finally {
    submitButton.disabled = false;
  }
});

profileButton.addEventListener('click', async () => {
  try {
    if (!secure) {
      await startSecureSession();
    }
    const response = await secure.fetch('/api/me');
    const result = await response.json();
    if (!response.ok) {
      throw new Error(result.detail || 'profile request failed');
    }
    show(result);
  } catch (error) {
    show({error: error instanceof Error ? error.message : String(error)});
  }
});

logoutButton.addEventListener('click', async () => {
  logoutButton.disabled = true;
  try {
    if (secure) {
      await secure.revokeSession().catch(() => undefined);
      secure = undefined;
    }
    const response = await fetch('/auth/logout', {
      method: 'POST',
      credentials: 'same-origin',
    });
    if (!response.ok) {
      const result = await response.json().catch(() => ({}));
      throw new Error(result.detail || 'logout failed');
    }
    showAuthenticated(false);
    show({authenticated: false});
  } catch (error) {
    show({error: error instanceof Error ? error.message : String(error)});
  } finally {
    logoutButton.disabled = false;
  }
});

const restoreSession = async () => {
  try {
    const response = await fetch('/auth/session', {
      credentials: 'same-origin',
      cache: 'no-store',
    });
    const state = await response.json();
    if (!response.ok || !state.authenticated) {
      showAuthenticated(false);
      show({authenticated: false});
      return;
    }
    showAuthenticated(true);
    await startSecureSession();
  } catch (error) {
    showAuthenticated(false);
    show({error: error instanceof Error ? error.message : String(error)});
  }
};

void restoreSession();
