package main

import (
	"crypto/ed25519"
	"crypto/sha256"
	"crypto/subtle"
	"encoding/base64"
	"flag"
	"fmt"
	"log"
	"strings"
	"time"

	appauth "__FH_MODULE__/internal/auth"
	appconfig "__FH_MODULE__/internal/config"
	appdb "__FH_MODULE__/internal/database"
	apphttp "__FH_MODULE__/internal/httpapi"
	"github.com/oarkflow/fh"
	contriblogger "github.com/oarkflow/fh-contrib/logger"
	authzmw "github.com/oarkflow/fh-contrib/mw/authz"
	"github.com/oarkflow/fh/mw/auditlog"
	"github.com/oarkflow/fh/mw/bodylimit"
	"github.com/oarkflow/fh/mw/cors"
	"github.com/oarkflow/fh/mw/earlydata"
	"github.com/oarkflow/fh/mw/fetchmetadata"
	responsemiddleware "github.com/oarkflow/fh/mw/httpsignature"
	"github.com/oarkflow/fh/mw/logger"
	"github.com/oarkflow/fh/mw/metrics"
	"github.com/oarkflow/fh/mw/ratelimiter"
	"github.com/oarkflow/fh/mw/requestid"
	"github.com/oarkflow/fh/mw/securetransport"
	"github.com/oarkflow/fh/mw/security"
	"github.com/oarkflow/fh/mw/session"
	"github.com/oarkflow/fh/mw/skip"
	"github.com/oarkflow/fh/mw/timeout"
	responseprotocol "github.com/oarkflow/fh/pkg/httpsignature"
	secureprotocol "github.com/oarkflow/fh/pkg/securetransport"
	"github.com/oarkflow/fh/pkg/storage/kv"
	"github.com/oarkflow/template"
	"github.com/oarkflow/zlog"
)

func main() {
	generateTransport := flag.Bool("generate-transport-key", false, "print a base64url X25519 private key")
	generateSigning := flag.Bool("generate-signing-key", false, "print an Ed25519 private seed and public key")
	flag.Parse()
	if *generateTransport {
		generateTransportKey()
		return
	}
	if *generateSigning {
		generateSigningKey()
		return
	}

	cfg, err := appconfig.Load()
	if err != nil {
		log.Fatal(err)
	}
	zlogger := zlog.NewProduction()
	appLogger := &contriblogger.ZlogAdapter{Logger: zlogger}
	db, err := appdb.Open(cfg.DatabaseURL)
	if err != nil {
		log.Fatal(err)
	}
	defer db.Close()
	engine, err := authzmw.LoadEngineFromAuthzFile("policy.authz")
	if err != nil {
		log.Fatal(err)
	}
	view := template.NewSPL("web/templates", ".html").Config(template.SPLConfig{Directory: "web/templates", SSR: true, SecureMode: true})
	environment := fh.EnvDevelopment
	mode := fh.ModeDevelopment
	if cfg.Production {
		environment = fh.EnvProduction
		mode = fh.ModeProduction
	}
	app := fh.NewProduction(
		fh.WithLogger(appLogger), fh.WithTemplateEngine(view), fh.WithEnvironment(environment), fh.WithMode(mode), fh.WithSecureByDefault(cfg.Production),
		fh.WithAllowedHosts(cfg.AllowedHosts...), fh.WithMaxRequestBodySize(cfg.MaxBodyBytes), fh.WithHandlerTimeout(cfg.RequestTimeout),
		fh.WithReadHeaderTimeout(5*time.Second), fh.WithRequestBodyTimeout(10*time.Second), fh.WithShutdownTimeout(20*time.Second),
		fh.WithMaxConnectionsPerIP(100), fh.WithMaxInFlightRequests(1_000), fh.WithMaxHeaderCount(64), fh.WithMaxHeaderListSize(32<<10),
	)

	secureCookie := cfg.Production
	cookieName := "fh_session"
	if secureCookie {
		cookieName = "__Host-fh_session"
	}
	sessions := session.NewSessionManager(
		kv.NewMemoryStore(kv.WithGCInterval(time.Minute), kv.WithMaxEntries(100_000)),
		session.SessionSecret(cfg.SessionSecret), session.SessionCookieName(cookieName), session.SessionMaxAge(30*time.Minute),
		session.SessionHTTPOnly(true), session.SessionSecure(secureCookie), session.SessionSameSite(fh.SameSiteStrict), session.SessionPath("/"),
	)
	requestMetrics := metrics.New()
	app.Use(
		requestid.New(),
		logger.New(logger.Config{Logger: appLogger, FormatName: "json", SkipDefaultStatic: true}),
		requestMetrics.Middleware(),
		auditlog.New(auditlog.Config{MinSeverity: auditlog.SeverityWarning, Logger: appLogger}),
		earlydata.New(),
		fetchmetadata.New(fetchmetadata.Config{AllowTopLevelNavigations: true}),
		security.New(security.Config{
			ContentSecurityPolicy: "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'",
			HSTSMaxAge:            hstsAge(cfg.Production), HSTSIncludeSubDomains: cfg.Production, DisableHSTS: !cfg.Production, FrameDeny: true, ContentTypeNosniff: true, XSSProtection: "0",
			CrossOriginOpenerPolicy: "same-origin", CrossOriginResourcePolicy: "same-origin", CrossOriginEmbedderPolicy: "require-corp",
			ReferrerPolicy: "no-referrer", PermissionsPolicy: "geolocation=(), microphone=(), camera=(), payment=(), usb=()",
		}),
		cors.New(cors.Config{
			AllowOrigins: cfg.AllowedOrigins, AllowMethods: []string{"GET", "POST", "OPTIONS"},
			AllowHeaders:  []string{"Origin", "Content-Type", "Accept", "Accept-Signature", "X-FH-Envelope", "X-FH-Device-Registration"},
			ExposeHeaders: []string{"X-Request-ID", "X-FH-Response", "Content-Digest", "Signature-Input", "Signature"}, AllowCredentials: true, MaxAge: 600,
		}),
		bodylimit.New(cfg.MaxBodyBytes), timeout.New(cfg.RequestTimeout),
		ratelimiter.New(ratelimiter.Config{Max: cfg.RateLimit, Window: time.Minute, SendHeaders: true}),
		skip.New(session.New(sessions), skip.Any(skip.Paths("/", "/healthz"), skip.Prefixes("/assets/", "/wasm/", "/_ops/"))),
	)

	serverKey, ephemeralTransport, err := transportKey(cfg)
	if err != nil {
		log.Fatal(err)
	}
	grants := appauth.NewGrantStore()
	transport, err := securetransport.Install(app, securetransport.Config{
		ServerPrivateKey: serverKey, AllowEphemeralServerKey: ephemeralTransport, KeyID: cfg.TransportKeyID,
		RequireSecure: true, Protect: func(c fh.Ctx) bool { return strings.HasPrefix(c.Path(), "/api/") },
		AllowedOrigins: cfg.AllowedOrigins, RequireOrigin: true,
		AuthorizeDeviceRegistration: func(c fh.Ctx, _ secureprotocol.DeviceRegistrationRequest) (string, error) {
			principal, ok := appauth.Principal(c)
			if !ok || !grants.Consume(c.Get(secureprotocol.HeaderDeviceRegistration), principal.ID, session.Get(c).ID) {
				return "", fh.NewHTTPError(fh.StatusForbidden, "DEVICE_REGISTRATION_FORBIDDEN", "device registration grant is missing, expired, or already used")
			}
			return principal.ID, nil
		},
		ValidateSession: func(c fh.Ctx, secure securetransport.SessionInfo) error {
			principal, ok := appauth.Principal(c)
			if !ok || !constantEqual(principal.ID, secure.Principal) {
				return fh.NewHTTPError(fh.StatusUnauthorized, "SESSION_BINDING_FAILED", "session binding failed")
			}
			return nil
		},
		OnSecurityEvent: func(event securetransport.SecurityEvent) {
			appLogger.Warn("secure_transport_event", "type", event.Type, "device", event.DeviceID, "request", event.RequestID, "ip", event.IP)
		},
	})
	if err != nil {
		log.Fatal(err)
	}

	responsePublic, responsePrivate, ephemeralSigning, err := signingKey(cfg)
	if err != nil {
		log.Fatal(err)
	}
	signer, err := responsemiddleware.New(responsemiddleware.Config{
		PrivateKey: responsePrivate, KeyID: cfg.ResponseSigningKeyID, Origin: cfg.Origin, AllowedOrigins: cfg.AllowedOrigins,
		AllowInsecureDevelopmentOrigins: !cfg.Production, Validity: 90 * time.Second,
		MaxBodySize: secureprotocol.DefaultMaxBody + 64<<10, Skip: func(c fh.Ctx) bool { return !strings.HasPrefix(c.Path(), "/api/") },
	})
	if err != nil {
		log.Fatal(err)
	}
	// securetransport encrypts the logical response; the outer middleware then signs the ciphertext.
	app.Use(signer)
	responsePublicValue, _ := responseprotocol.EncodePublicKey(responsePublic)
	app.AddHealthCheck("database", 2*time.Second, db.Ping)
	if err := apphttp.Register(app, cfg, sessions, transport, engine, grants, responsePublicValue); err != nil {
		log.Fatal(err)
	}
	app.Get("/_ops/metrics", operationAuth(cfg.OperationsToken), requestMetrics.Handler()).Name("metrics").Tag("operations")
	app.EnableHealth("/_ops", operationAuth(cfg.OperationsToken))
	app.EnableRuntime("/_ops", operationAuth(cfg.OperationsToken))
	if ephemeralTransport || ephemeralSigning {
		appLogger.Warn("development-only ephemeral cryptographic keys are active")
	}
	appLogger.Info("starting server", "addr", cfg.Address, "origin", cfg.Origin, "environment", cfg.Environment)
	log.Fatal(app.ListenWithGracefulShutdown(cfg.Address))
}

func transportKey(cfg appconfig.Config) ([]byte, bool, error) {
	if cfg.TransportPrivateKey == "" {
		if cfg.Production {
			return nil, false, fmt.Errorf("persistent transport key required")
		}
		return nil, true, nil
	}
	key, err := securetransport.DecodeServerPrivateKey(cfg.TransportPrivateKey)
	return key, false, err
}

func signingKey(cfg appconfig.Config) (ed25519.PublicKey, ed25519.PrivateKey, bool, error) {
	if cfg.ResponseSigningPrivateKey == "" {
		public, private, err := responseprotocol.GenerateKey()
		return public, private, true, err
	}
	private, err := responseprotocol.DecodePrivateKey(cfg.ResponseSigningPrivateKey)
	if err != nil {
		return nil, nil, false, err
	}
	return private.Public().(ed25519.PublicKey), private, false, nil
}

func operationAuth(token string) fh.HandlerFunc {
	return func(c fh.Ctx) error {
		authorization := c.Get("Authorization")
		if token == "" || !strings.HasPrefix(authorization, "Bearer ") || !constantEqual(strings.TrimPrefix(authorization, "Bearer "), token) {
			return fh.NewHTTPError(fh.StatusUnauthorized, "OPERATIONS_AUTH_REQUIRED", "operations authentication required")
		}
		return c.Next()
	}
}

func constantEqual(a, b string) bool {
	ah := sha256.Sum256([]byte(a))
	bh := sha256.Sum256([]byte(b))
	return subtle.ConstantTimeCompare(ah[:], bh[:]) == 1
}
func hstsAge(enabled bool) int {
	if enabled {
		return 31536000
	}
	return 0
}
func generateTransportKey() {
	key, err := securetransport.GenerateServerPrivateKey()
	if err != nil {
		log.Fatal(err)
	}
	value, err := securetransport.EncodeServerPrivateKey(key)
	if err != nil {
		log.Fatal(err)
	}
	public, err := securetransport.ServerPublicKey(key)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Printf("APP_SECURE_TRANSPORT_KEY=%s\nWASM_TRUSTED_TRANSPORT_KEY=%s\n", value, base64.RawURLEncoding.EncodeToString(public[:]))
}
func generateSigningKey() {
	public, private, err := responseprotocol.GenerateKey()
	if err != nil {
		log.Fatal(err)
	}
	privateValue, _ := responseprotocol.EncodePrivateKey(private)
	publicValue, _ := responseprotocol.EncodePublicKey(public)
	fmt.Printf("APP_RESPONSE_SIGNING_PRIVATE_KEY=%s\nWASM_TRUSTED_RESPONSE_KEY=%s\n", privateValue, publicValue)
}
