# Minimal production image from binaries cross-compiled on a build machine.
# Expects ./bin/{mira-tls-server,mira-healthcheck} (linux, static). Secrets are
# mounted at runtime, never baked.
FROM scratch
COPY bin/mira-tls-server /mira-tls-server
COPY bin/mira-healthcheck /mira-healthcheck
USER 65532:65532
EXPOSE 7447/udp 7448/tcp
HEALTHCHECK --interval=15s --timeout=4s --start-period=5s --retries=3 CMD ["/mira-healthcheck"]
ENTRYPOINT ["/mira-tls-server"]
