APP_CONFIG=config.bcl
APP_NAME={{APP_NAME}}
APP_ADDR=:8080
APP_ENV=development
APP_DEBUG=true
APP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
APP_DEV_AUTH=false
APP_AUTH_CONFIGURED=false
APP_REQUEST_TIMEOUT=30s
APP_MAX_BODY_BYTES=4194304
APP_RATE_LIMIT=100
APP_DATABASE_ENABLED=true
APP_DATABASE_DRIVER=sqlite
APP_DATABASE_DSN=file:app.db?_pragma=foreign_keys(1)
APP_DATABASE_NAME=app
APP_AUTH_JWT_SECRET_FILE=
APP_SESSION_SECRET_FILE=
APP_BOOTSTRAP_USERNAME=admin
APP_BOOTSTRAP_PASSWORD_FILE=
# Production adapters must provide their own credentials through mounted secret files.
