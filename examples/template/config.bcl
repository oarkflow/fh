name env("APP_NAME", "{{APP_NAME}}")
addr env("APP_ADDR", ":8080")
environment env("APP_ENV", "development")
debug env.bool("APP_DEBUG", true)
allowed_hosts env("APP_ALLOWED_HOSTS", "localhost,127.0.0.1,::1")
development_auth env.bool("APP_DEV_AUTH", false)
auth_configured env.bool("APP_AUTH_CONFIGURED", false)
request_timeout env("APP_REQUEST_TIMEOUT", "30s")
max_body_bytes env.int("APP_MAX_BODY_BYTES", 4194304)
rate_limit env.int("APP_RATE_LIMIT", 100)
database_enabled env.bool("APP_DATABASE_ENABLED", true)
database_driver env("APP_DATABASE_DRIVER", "sqlite")
database_dsn env("APP_DATABASE_DSN", "file:app.db?_pragma=foreign_keys(1)")
database_name env("APP_DATABASE_NAME", "app")
bootstrap_user env("APP_BOOTSTRAP_USERNAME", "admin")
