# Development binds to loopback. Set an explicit address/origin to expose it on a trusted network.
APP_ENV=development
APP_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:8080
APP_DATABASE_URL='file:data/app.db?_pragma=foreign_keys(1)'
# base64url encoding of exactly 32 development-only bytes
APP_SESSION_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY
APP_LOGIN_USER=admin
APP_LOGIN_PASSWORD=change-me-in-development
APP_OPERATIONS_TOKEN=change-me-ops-token
APP_REQUEST_TIMEOUT=15s
APP_MAX_BODY_BYTES=1048576
APP_RATE_LIMIT=120
APP_SECURE_TRANSPORT_KEY_ID=app-transport-v1
APP_RESPONSE_SIGNING_KEY_ID=app-response-v1
# Empty keys are permitted only in development and are regenerated at startup.
APP_SECURE_TRANSPORT_KEY=
APP_RESPONSE_SIGNING_PRIVATE_KEY=
# Production examples:
# APP_SESSION_SECRET_FILE=/run/secrets/session
# APP_LOGIN_PASSWORD_FILE=/run/secrets/login-password
# APP_OPERATIONS_TOKEN_FILE=/run/secrets/operations-token
# APP_SECURE_TRANSPORT_KEY_FILE=/run/secrets/transport-key
# APP_RESPONSE_SIGNING_PRIVATE_KEY_FILE=/run/secrets/response-signing-key
