# Environment-specific; .env.example documents the same keys with
# development-safe placeholder values. fh-init never overwrites an
# existing .env (see README.md).
/.env

# SQLite database and its WAL/SHM siblings.
/data/

# Frontend build tooling and output. Nothing here is checked in; run
# `make frontend` (needs Node 22.6+) to build web/public/app.js + app.css
# from web/frontend/src before the server has anything to serve at
# /assets/*. See web/frontend/README.md.
/web/frontend/node_modules/
/web/frontend/dist/
/web/public/

# Local build artifacts.
/bin/
*.db
*.db-shm
*.db-wal

.DS_Store
