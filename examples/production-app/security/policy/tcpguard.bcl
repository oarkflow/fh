pack "github.com/oarkflow/fh/examples/production-app-anomaly-protection" {
  version "1.0.0"
  mode enforce
}

guard "github.com/oarkflow/fh/examples/production-app-guard" {
  mode enforce
  version "1.0.0"
}

policy_safety {
  max_detector_timeout 25ms
  max_action_timeout 1s
  max_actions_per_rule 6
}

# The built-in abuse detector turns raw request/event volume into named
# facts (abuse.auth.ip_failures, abuse.fn.invocations, ...). Auth-related
# thresholds are deliberately tight (a real login form is used a handful of
# times per session, so 5 failures in 10 minutes is already suspicious).
# scan_path_threshold is deliberately NOT tight: distinct_paths counts the
# exact request path, so a REST resource like /api/notes/:id adds one new
# "distinct path" per note ID a legitimate user touches. A normal session
# through this app's own ~10 routes plus a handful of note operations can
# reach 20-30 distinct paths on its own; keep this threshold well above your
# app's real per-session path count, or it will flag ordinary use as
# scanning (see the endpoint-scanning-probe rule below, and
# https://github.com/oarkflow/tcpguard#abuse-parameters).
detector "abuse" {
  type abuse
  window 10m
  auth_ip_failure_threshold 5
  auth_user_failure_threshold 5
  password_spray_user_threshold 5
  scan_path_threshold 60
  account_enumeration_threshold 5
  function_invoke_threshold 20
  large_body_threshold 1048576
}

threat_model "abuse-default" {
  category account_takeover {
    findings ["account_takeover_risk", "session_country_changed"]
  }
  category bot_abuse {
    findings ["credential_stuffing", "password_spray", "account_enumeration", "endpoint_scanning"]
  }
  category function_abuse {
    findings ["function_invocation_velocity", "function_error_abuse"]
  }
  category application_abuse {
    findings ["path_traversal_probe", "injection_probe", "xss_probe", "ssrf_probe"]
  }
}

# Credential-stuffing / brute-force protection on /auth/login. The handler
# emits auth.login_failed/auth.login_success events explicitly (see
# internal/httpapi/routes.go) since a failed login never reaches the request
# body far enough to be distinguishable from a successful one by status code
# alone once responses are uniform.
rule "auth-brute-force" {
  name "Block brute-force login attempts"
  status active
  priority 900

  trigger {
    on auth.login_failed
  }

  when {
    any {
      abuse.auth.ip_failures greater_or_equal 5
      abuse.auth.user_failures greater_or_equal 5
      abuse.enumeration.distinct_users greater_or_equal 5
    }
  }

  risk {
    base 85
    max 100
  }

  severity {
    critical when risk.score greater_or_equal 80
  }

  actions {
    critical {
      run block
      run create_incident
    }
  }
}

# NOTE ON SEVERITY: tcpguard maps each rule's *severity* bucket straight to
# an enforcement effect in enforce mode - critical=block, high=challenge
# (401), medium=throttle (429), everything else=monitor (see tcpguard's
# guard.go decide()) - regardless of which action verbs are listed below.
# Reserve "high"/"critical" for signals a legitimate user's traffic cannot
# produce; a volume-based signal like "visited many paths" belongs at
# "medium" (throttle), because real usage can approach it.

# High path-volume from one IP: could be a legitimate power user or a
# scanner: throttle, don't block/challenge.
rule "endpoint-scanning-volume" {
  name "Throttle unusually high endpoint volume"
  status active
  priority 800

  trigger {
    on request.received
  }

  when {
    abuse.scan.distinct_paths greater_or_equal 60
  }

  risk {
    base 45
    max 65
  }

  severity {
    medium when risk.score greater_or_equal 40
  }

  actions {
    medium {
      run throttle
    }
  }
}

# Actual attack probes (path traversal, injection, SSRF) are a much
# stronger signal than raw path volume - ordinary navigation through this
# app's own routes never produces one, so these stay high-severity.
rule "endpoint-scanning-probe" {
  name "Block application attack probes"
  status active
  priority 810

  trigger {
    on request.received
  }

  when {
    any {
      abuse.application.path_traversal equals true
      abuse.application.injection_probe equals true
      abuse.application.ssrf_probe equals true
    }
  }

  risk {
    base 85
    max 100
  }

  severity {
    critical when risk.score greater_or_equal 80
  }

  actions {
    critical {
      run block
      run create_incident
    }
  }
}

# Business-logic anomaly example: runaway note creation (a scripted client
# hammering /api/notes) is a "function invocation" from tcpguard's point of
# view - see security.Guard.EmitBusinessEvent, called from the notes-create
# handler.
rule "note-creation-velocity" {
  name "Throttle runaway note creation"
  status active
  priority 700

  trigger {
    on function.invoked
  }

  when {
    abuse.fn.invocations greater_or_equal 20
  }

  risk {
    base 60
    max 90
  }

  severity {
    medium when risk.score greater_or_equal 50
  }

  actions {
    medium {
      run throttle
    }
  }
}
