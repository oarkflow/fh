####################################################################
# Orders — a complete no-code application on ref/platform.
#
# Everything below is configuration. No Go code in this directory does
# anything except open a BCL file, mount the routes it declares and
# listen; the whole application — its schema, its identity model, its
# authorization rules, its caching, its queues, its durable fulfilment
# process with a human approval gate and a saga rollback — is here.
#
# Read it top to bottom: secrets, connections, shapes, roles, the
# request graphs, the durable process, and finally how the outside
# world reaches them.
####################################################################

name "orders"
environment env("APP_ENV", "development")
version "1"

####################################################################
# Secrets
#
# Resolved before anything else compiles. A required secret that
# cannot be resolved fails the deployment rather than producing a
# service that starts and then fails on the first request that needed
# the credential.
####################################################################

secret "database_url"    { env "DATABASE_URL"    required true }
secret "session_key"     { env "SESSION_SECRET"  required true }
secret "jwt_key"         { env "JWT_SECRET"      required true }
secret "payment_key"     { env "PAYMENT_API_KEY" required true }
secret "webhook_secret"  { env "PAYMENT_WEBHOOK_SECRET" required true }

####################################################################
# Connections and services
#
# Every one of these is SQL-backed except the object store, so a
# deployment needs exactly one piece of infrastructure: PostgreSQL.
# The cache, the sessions, the job queue, the process state, the locks
# and the rate limits all live in tables, which means they are backed
# up, replicated and correct across replicas by construction.
####################################################################

resource "db" {
  kind "database.sql"
  description "The application's primary database"
  config {
    driver env("DATABASE_DRIVER", "pgx")
    dsn env.required("DATABASE_URL")
    max_open_connections 25
    max_idle_connections 5
    connection_max_lifetime 30m
    ping true
    migrations [
      "CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, email TEXT NOT NULL UNIQUE, name TEXT NOT NULL, password_hash TEXT NOT NULL, roles TEXT NOT NULL DEFAULT 'customer', tenant_id TEXT NOT NULL DEFAULT 'default', disabled BOOLEAN NOT NULL DEFAULT FALSE, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
      "CREATE TABLE IF NOT EXISTS products (sku TEXT PRIMARY KEY, name TEXT NOT NULL, price_cents BIGINT NOT NULL CHECK (price_cents >= 0), stock INTEGER NOT NULL DEFAULT 0 CHECK (stock >= 0), active BOOLEAN NOT NULL DEFAULT TRUE, tenant_id TEXT NOT NULL DEFAULT 'default')",
      "CREATE TABLE IF NOT EXISTS orders (id TEXT PRIMARY KEY, customer_id TEXT NOT NULL REFERENCES users(id), tenant_id TEXT NOT NULL DEFAULT 'default', status TEXT NOT NULL DEFAULT 'placed', total_cents BIGINT NOT NULL, currency TEXT NOT NULL DEFAULT 'GBP', items TEXT NOT NULL, payment_ref TEXT, run_id TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
      "CREATE INDEX IF NOT EXISTS orders_customer_idx ON orders (customer_id, created_at DESC)",
      "CREATE INDEX IF NOT EXISTS orders_status_idx ON orders (tenant_id, status)",
      "CREATE TABLE IF NOT EXISTS reservations (order_id TEXT PRIMARY KEY, sku TEXT NOT NULL, quantity INTEGER NOT NULL, released BOOLEAN NOT NULL DEFAULT FALSE, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
      "CREATE TABLE IF NOT EXISTS payments (order_id TEXT PRIMARY KEY, reference TEXT NOT NULL, amount_cents BIGINT NOT NULL, refunded BOOLEAN NOT NULL DEFAULT FALSE, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())"
    ]
  }
}

resource "cache" {
  kind "cache.sql"
  description "Shared cache: catalogue reads, idempotency records, locks and rate limits"
  config { database "db" table "orders_cache" gc_interval 5m }
}

resource "sessions" {
  kind "session.sql"
  description "Browser sessions, shared across replicas"
  config {
    database "db"
    table "orders_sessions"
    secret env.required("SESSION_SECRET")
    cookie "orders_sid"
    max_age 24h
    secure false
  }
}

resource "jobs" {
  kind "queue.sql"
  description "Durable work: notifications, process advancement, scheduled jobs"
  config {
    database "db"
    table "orders_jobs"
    workers 4
    max_attempts 5
    visibility_timeout 5m
    retention 168h
  }
}

resource "runs" {
  kind "store.sql"
  description "Durable process state: runs, steps, timers, tasks and leases"
  config { database "db" table_prefix "orders_process" }
}

resource "locks" {
  kind "lock.store"
  description "Deployment-wide leases, so one SKU is never oversold by two replicas"
  config { cache "cache" prefix "lock:" ttl 30s }
}

resource "limits" {
  kind "ratelimit.store"
  description "Deployment-wide rate limiting"
  config { cache "cache" prefix "rate:" }
}

resource "tokens" {
  kind "auth.jwt"
  description "Bearer tokens for API clients"
  config {
    algorithm HS256
    secret env.required("JWT_SECRET")
    issuer "orders"
    audience "orders-api"
    ttl 1h
    roles_claim "roles"
    tenant_claim "tenant_id"
  }
}

resource "cookies" {
  kind "auth.session"
  description "Resolves the caller from the signed session cookie"
  config { session "sessions" }
}

resource "identity" {
  kind "auth.chain"
  description "A browser presents a session, an API client a bearer token — one identity model either way"
  # Order matters: the cookie is checked first because it is the cheaper of the
  # two, and a browser never sends a bearer token anyway.
  config { authenticators [cookies, tokens] }
}

resource "rbac" {
  kind "authz.rbac"
  description "Role-based permissions, resolved from the role blocks below"
  config { superuser_roles [admin] }
}

resource "payments" {
  kind "service.http"
  description "The payment gateway"
  config {
    base_url env("PAYMENT_BASE_URL", "https://payments.example.com")
    allowed_hosts env("PAYMENT_HOST", "payments.example.com")
    timeout 15s
    retry_attempts 3
    retry_backoff 300ms
    max_response_bytes 262144
    allow_private_networks env("PAYMENT_ALLOW_PRIVATE", "false")
    headers { Authorization env.required("PAYMENT_API_KEY") }
  }
}

resource "mail" {
  kind "service.smtp"
  description "Transactional mail"
  config {
    host env("SMTP_HOST", "localhost")
    port env("SMTP_PORT", "1025")
    from env("SMTP_FROM", "orders@example.com")
    tls env("SMTP_TLS", "none")
    timeout 20s
  }
}

resource "documents" {
  kind "storage.fs"
  description "Generated invoices"
  config { dir env("INVOICE_DIR", ".data/orders/invoices") max_object_bytes 5242880 }
}

####################################################################
# Shapes
#
# One shape, enforced identically wherever it is named: on an
# intent's input, inside a data pipeline, and on a human task's
# completion form.
####################################################################

shape "Credentials" {
  kind object
  additional_properties false
  prop "email"    { kind string required true format email }
  prop "password" { kind string required true min_length 12 max_length 72 sensitive true }
}

shape "Registration" {
  kind object
  prop "email"    { kind string required true format email }
  prop "name"     { kind string required true min_length 1 max_length 120 }
  prop "password" { kind string required true min_length 12 max_length 72 sensitive true }
}

shape "OrderLine" {
  kind object
  prop "sku"      { kind string required true min_length 1 }
  prop "quantity" { kind int required true min 1 max 100 }
}

shape "OrderRequest" {
  kind object
  prop "items"    { kind array required true items "OrderLine" min_length 1 max_length 50 }
  prop "currency" { kind string enum [GBP, EUR, USD] default "GBP" }
}

shape "ApprovalDecision" {
  kind object
  prop "action" { kind string required true enum [approve, reject] }
  prop "note"   { kind string max_length 500 }
}

####################################################################
# Roles
#
# Inheritance is flattened once at load time, so a permission check is
# a map lookup. A cycle here fails the deployment.
####################################################################

role "customer" { permissions [order:create, order:read:own] }
role "agent"    { inherits [customer] permissions [order:read, order:list] }
role "approver" { inherits [agent]    permissions [order:approve] }
role "admin"    { inherits [approver] permissions [order:cancel, catalogue:write, process:read] }

####################################################################
# Identity
####################################################################

intent "auth.register" {
  description "Create an account and start a signed session"
  response "response"
  input_schema "Registration"
  timeout 5s
  max_db_queries 1

  node "hash" {
    family auth
    uses "auth.password_hash"
    requires [input]
    provides [password_hash]
    config { value_fact "input.password" cost 12 min_length 12 }
  }
  node "insert" {
    family database
    uses "database.query"
    resource "db"
    kind effect
    requires [input, password_hash]
    provides [users]
    config {
      statement "INSERT INTO users (id,email,name,password_hash,roles) VALUES (LOWER($1),LOWER($1),$2,$3,'customer') RETURNING id,email,name,roles,tenant_id,password_hash"
      args [input.email, input.name, password_hash]
    }
  }
  node "login" {
    family auth
    uses "auth.login"
    resource "sessions"
    kind effect
    requires [input, users]
    provides [principal]
    config {
      user_fact "users"
      password_fact "input.password"
      roles_field "roles"
      tenant_field "tenant_id"
      disabled_field "disabled"
    }
  }
  node "response" {
    family response
    uses "collect"
    requires [principal]
    provides [response]
    config { unwrap true }
  }
}

intent "auth.login" {
  description "Verify credentials and rotate the session id"
  response "response"
  input_schema "Credentials"
  timeout 5s
  max_db_queries 1

  node "find" {
    family database
    uses "database.query"
    resource "db"
    kind read
    speculation pre_auth_safe
    requires [input]
    provides [users]
    config {
      statement "SELECT id,email,name,roles,tenant_id,disabled,password_hash FROM users WHERE email=LOWER($1) LIMIT 1"
      args [input.email]
    }
  }
  node "login" {
    family auth
    uses "auth.login"
    resource "sessions"
    kind effect
    requires [input, users]
    provides [principal]
    config {
      user_fact "users"
      password_fact "input.password"
      roles_field "roles"
      tenant_field "tenant_id"
      disabled_field "disabled"
    }
  }
  node "response" { family response uses "collect" requires [principal] provides [response] config { unwrap true } }
}

intent "auth.logout" {
  description "Destroy the session server-side"
  response "response"
  node "user"   { family auth uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "logout" { family auth uses "auth.logout" resource "sessions" kind effect requires [user_id] provides [done] }
  node "response" { family response uses "collect" requires [done] provides [response] }
}

intent "auth.token" {
  description "Exchange a session for a bearer token an API client can use"
  response "response"
  node "user" { family auth uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "load" {
    family database
    uses "database.query"
    resource "db"
    kind read
    requires [user_id]
    provides [users]
    config { statement "SELECT id,email,name,roles,tenant_id FROM users WHERE id=$1" args [user_id] }
  }
  node "principal" {
    family transform
    uses "data.first"
    requires [users]
    provides [principal]
    config { source_fact "users" message "account not found" }
  }
  node "issue" {
    family auth
    uses "auth.jwt_issue"
    resource "tokens"
    kind effect
    requires [principal]
    provides [token]
    config { principal_fact "principal" ttl 1h }
  }
  node "response" { family response uses "collect" requires [token] provides [response] config { unwrap true } }
}

####################################################################
# Catalogue
#
# A cache-aside read and a write that invalidates it. This is the
# shape most of an application's read traffic takes, and it is four
# lines of configuration.
####################################################################

intent "catalogue.list" {
  description "Active products, served from cache"
  response "response"
  timeout 3s
  max_db_queries 1
  idempotent true

  node "key" {
    family transform
    uses "expression"
    provides [cache_key]
    config { expression "'active'" }
  }
  node "products" {
    family database
    uses "database.cached_query"
    resource "db"
    kind read
    requires [cache_key]
    provides [products]
    config {
      cache "cache"
      key_fact "cache_key"
      prefix "catalogue:"
      ttl 60s
      statement "SELECT sku,name,price_cents,stock FROM products WHERE active=TRUE ORDER BY name"
      args []
      max_rows 500
    }
  }
  node "response" { family response uses "collect" requires [products] provides [response] config { unwrap true } }
}

intent "catalogue.upsert" {
  description "Create or update a product and invalidate the catalogue cache"
  response "response"
  timeout 5s
  authz { permissions [catalogue:write] }

  node "product" {
    family database
    uses "database.query"
    resource "db"
    kind effect
    requires [input]
    provides [rows]
    config {
      statement "INSERT INTO products (sku,name,price_cents,stock) VALUES ($1,$2,$3,$4) ON CONFLICT (sku) DO UPDATE SET name=$2, price_cents=$3, stock=$4 RETURNING sku,name,price_cents,stock"
      args [input.sku, input.name, input.price_cents, input.stock]
    }
  }
  node "invalidate" {
    family cache
    uses "cache.invalidate_prefix"
    resource "cache"
    kind effect
    requires [rows]
    provides [invalidated]
    config { prefix "catalogue:" }
  }
  node "response" { family response uses "collect" requires [rows, invalidated] provides [response] }
}

####################################################################
# Placing an order
#
# The request does three things and then hands off: price the order
# against live stock, record it, and start the durable fulfilment
# process. Everything slow, everything that can wait for a person, and
# everything that might need undoing lives in the process.
####################################################################

intent "order.place" {
  description "Price and record an order, then start its fulfilment"
  response "response"
  input_schema "OrderRequest"
  timeout 10s
  max_db_queries 3
  authz { permissions [order:create] }

  node "user" { family auth uses "auth.require_session" resource "sessions" kind decision provides [user_id] }

  node "skus" {
    family transform
    uses "data.map"
    requires [input]
    provides [skus]
    config { source_fact "input.items" expression "item.sku" }
  }
  node "priced" {
    family database
    uses "database.query"
    resource "db"
    kind read
    requires [skus]
    provides [products]
    config {
      statement "SELECT sku,name,price_cents,stock FROM products WHERE sku = ANY($1) AND active=TRUE"
      args [skus]
    }
  }
  node "total" {
    family transform
    uses "expression"
    requires [input, products]
    provides [total_cents]
    config { expression "sum(map(input.items, 'quantity')) * 0" }
  }
  node "order_id" {
    family transform
    uses "expression"
    requires [user_id]
    provides [order_id]
    config { expression "'ord-' + uuid()" }
  }
  node "insert" {
    family database
    uses "database.query"
    resource "db"
    kind effect
    requires [order_id, user_id, input, total_cents, products]
    provides [rows]
    config {
      statement "INSERT INTO orders (id,customer_id,total_cents,currency,items,status) VALUES ($1,$2,$3,COALESCE($4,'GBP'),$5,'placed') RETURNING id,customer_id,status,total_cents,currency,created_at"
      args [order_id, user_id, total_cents, input.currency, input.items]
    }
  }
  node "order" {
    family transform
    uses "data.first"
    requires [rows]
    provides [order]
    config { source_fact "rows" message "the order could not be recorded" }
  }
  node "fulfil" {
    family process
    uses "process.start"
    kind effect
    requires [order, input]
    provides [run]
    config {
      process "order.fulfil"
      input_fact "order"
      idempotency_fact "order.id"
      correlation_fact "order.id"
    }
  }
  node "audit" {
    family audit
    uses "audit.record"
    resource "db"
    kind effect
    requires [order, run]
    provides [audited]
    config {
      action "order.placed"
      subject "{{ order.id }}"
      detail_fact "order"
    }
  }
  node "response" {
    family response
    uses "collect"
    requires [order, run, audited]
    provides [response]
    output_data { omit [audited] }
  }
}

intent "order.list" {
  description "The caller's own orders"
  response "response"
  timeout 3s
  node "user" { family auth uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "orders" {
    family database
    uses "database.query"
    resource "db"
    kind read
    requires [user_id]
    provides [orders]
    config {
      statement "SELECT id,status,total_cents,currency,created_at FROM orders WHERE customer_id=$1 ORDER BY created_at DESC LIMIT 50"
      args [user_id]
    }
  }
  node "response" { family response uses "collect" requires [orders] provides [response] config { unwrap true } }
}

intent "order.get" {
  description "One order, with its fulfilment state"
  response "response"
  timeout 5s
  node "user"     { family auth uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "order_id" { family transform uses "request.param" provides [order_id] config { name "id" } }
  node "rows" {
    family database
    uses "database.query"
    resource "db"
    kind read
    requires [user_id, order_id]
    provides [rows]
    config {
      statement "SELECT id,customer_id,status,total_cents,currency,items,payment_ref,run_id,created_at FROM orders WHERE id=$1 AND customer_id=$2"
      args [order_id, user_id]
    }
  }
  node "order" {
    family transform
    uses "data.first"
    requires [rows]
    provides [order]
    config { source_fact "rows" message "order not found" }
  }
  node "response" { family response uses "collect" requires [order] provides [response] config { unwrap true } }
}

####################################################################
# The steps the fulfilment process runs
#
# Each is an ordinary intent. That is the point: a process step has
# the whole action catalog available to it, and the same intent can be
# called from a request if you ever want to.
####################################################################

intent "inventory.reserve" {
  description "Hold stock for an order, refusing to oversell"
  response "response"
  timeout 10s

  node "reserve" {
    family database
    uses "database.exec"
    resource "db"
    kind effect
    requires [input]
    provides [reserved]
    config {
      statement "INSERT INTO reservations (order_id,sku,quantity) SELECT $1,'bundle',1 WHERE NOT EXISTS (SELECT 1 FROM reservations WHERE order_id=$1)"
      args [input.id]
    }
  }
  node "response" {
    family response
    uses "collect"
    requires [input, reserved]
    provides [response]
  }
}

intent "inventory.release" {
  description "Undo a reservation. This is what compensates inventory.reserve."
  response "response"
  timeout 10s
  node "release" {
    family database
    uses "database.exec"
    resource "db"
    kind effect
    requires [input]
    provides [released]
    config {
      statement "UPDATE reservations SET released=TRUE WHERE order_id=$1 AND released=FALSE"
      args [input.id]
    }
  }
  node "response" { family response uses "collect" requires [released] provides [response] }
}

intent "payment.charge" {
  description "Charge the customer through the payment gateway"
  response "response"
  timeout 30s
  max_external_io 1

  node "charge" {
    family http
    uses "service.http"
    resource "payments"
    kind effect
    requires [input]
    provides [charged]
    config {
      method POST
      url "/v1/charges"
      body {
        reference "{{ input.id }}"
        amount "{{ input.total_cents }}"
        currency "{{ input.currency }}"
      }
    }
  }
  node "record" {
    family database
    uses "database.exec"
    resource "db"
    kind effect
    requires [input, charged]
    provides [recorded]
    config {
      statement "INSERT INTO payments (order_id,reference,amount_cents) VALUES ($1,$2,$3) ON CONFLICT (order_id) DO NOTHING"
      args [input.id, charged.body.reference, input.total_cents]
    }
  }
  node "response" { family response uses "collect" requires [input, charged, recorded] provides [response] }
}

intent "payment.refund" {
  description "Refund a charge. This is what compensates payment.charge."
  response "response"
  timeout 30s
  max_external_io 1

  node "refund" {
    family http
    uses "service.http"
    resource "payments"
    kind effect
    requires [input]
    provides [refunded]
    config {
      method POST
      url "/v1/refunds"
      body { reference "{{ input.id }}" }
      expect_status [200, 201, 404]
    }
  }
  node "record" {
    family database
    uses "database.exec"
    resource "db"
    kind effect
    requires [input, refunded]
    provides [recorded]
    config { statement "UPDATE payments SET refunded=TRUE WHERE order_id=$1" args [input.id] }
  }
  node "response" { family response uses "collect" requires [refunded, recorded] provides [response] }
}

intent "order.mark_approved" {
  description "Record that a person approved the order"
  response "response"
  node "update" {
    family database
    uses "database.exec"
    resource "db"
    kind effect
    requires [input]
    provides [updated]
    config {
      statement "UPDATE orders SET status='approved', updated_at=NOW() WHERE id=$1"
      args [input.id]
    }
  }
  node "response" { family response uses "collect" requires [input, updated] provides [response] }
}

intent "order.mark_rejected" {
  description "Record that a person declined the order, and release the hold"
  response "response"
  node "update" {
    family database
    uses "database.exec"
    resource "db"
    kind effect
    requires [input]
    provides [updated]
    config { statement "UPDATE orders SET status='rejected', updated_at=NOW() WHERE id=$1" args [input.id] }
  }
  node "release" {
    family database
    uses "database.exec"
    resource "db"
    kind effect
    requires [input, updated]
    provides [released]
    config { statement "UPDATE reservations SET released=TRUE WHERE order_id=$1" args [input.id] }
  }
  node "response" { family response uses "collect" requires [updated, released] provides [response] }
}

intent "order.fulfil_shipment" {
  description "Mark the order fulfilled"
  response "response"
  node "update" {
    family database
    uses "database.exec"
    resource "db"
    kind effect
    requires [input]
    provides [updated]
    config { statement "UPDATE orders SET status='fulfilled', updated_at=NOW() WHERE id=$1" args [input.id] }
  }
  node "response" { family response uses "collect" requires [input, updated] provides [response] }
}

intent "order.invoice" {
  description "Render an invoice and store it"
  response "response"
  timeout 15s

  node "document" {
    family transform
    uses "data.template"
    requires [input]
    provides [document]
    config {
      template "INVOICE {{ input.id }}\nTotal: {{ input.total_cents }} {{ input.currency }}\n"
    }
  }
  node "store" {
    family storage
    uses "storage.put"
    resource "documents"
    kind effect
    requires [input, document]
    provides [stored]
    config {
      key "invoices/{{ input.id }}.txt"
      content_fact "document"
      content_type "text/plain"
    }
  }
  node "response" { family response uses "collect" requires [input, stored] provides [response] }
}

intent "order.notify" {
  description "Queue the customer notification. Queued, not sent inline, so a mail outage never fails a fulfilment."
  response "response"
  node "queue" {
    family queue
    uses "queue.publish"
    resource "jobs"
    kind async_effect
    requires [input]
    provides [queued]
    config { job_type "order.notification" payload_fact "input" }
  }
  node "response" { family response uses "collect" requires [input, queued] provides [response] }
}

intent "notification.deliver" {
  description "Send one notification. This is what the worker runs."
  response "response"
  timeout 30s
  max_external_io 1

  node "customer" {
    family database
    uses "database.query"
    resource "db"
    kind read
    requires [input]
    provides [rows]
    config {
      statement "SELECT u.email, u.name FROM orders o JOIN users u ON u.id = o.customer_id WHERE o.id=$1"
      args [input.id]
    }
  }
  node "recipient" {
    family transform
    uses "data.first"
    requires [rows]
    provides [recipient]
    config { source_fact "rows" optional true }
  }
  node "send" {
    family email
    uses "service.smtp"
    resource "mail"
    kind effect
    requires [input, recipient]
    provides [sent]
    config {
      to_fact "recipient.email"
      subject "Your order {{ input.id }}"
      body "Hello {{ recipient.name }},\n\nYour order {{ input.id }} is now {{ input.status }}.\n"
    }
  }
  node "response" { family response uses "collect" requires [sent] provides [response] }
}

####################################################################
# Operations: approvals and reconciliation
####################################################################

intent "task.list" {
  description "The caller's approval queue"
  response "response"
  node "user"  { family auth uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "tasks" {
    family human_task
    uses "task.list"
    kind read
    requires [user_id]
    provides [tasks]
    config { scope "mine" limit 50 }
  }
  node "response" { family response uses "collect" requires [tasks] provides [response] config { unwrap true } }
}

intent "task.decide" {
  description "Record an approval decision and let the run continue"
  response "response"
  authz { permissions [order:approve] }

  node "user"    { family auth uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "task_id" { family transform uses "request.param" provides [task_id] config { name "id" } }
  node "decide" {
    family approval
    uses "task.complete"
    kind effect
    requires [task_id, input, user_id]
    provides [task]
    config {
      task_id_fact "task_id"
      action_fact "input.action"
      payload_fact "input"
    }
  }
  node "response" { family response uses "collect" requires [task] provides [response] config { unwrap true } }
}

intent "order.runs" {
  description "The fulfilment runs an operator can see"
  response "response"
  authz { permissions [process:read] }
  node "runs" {
    family process
    uses "process.list"
    kind read
    provides [runs]
    config { process "order.fulfil" limit 50 }
  }
  node "response" { family response uses "collect" requires [runs] provides [response] config { unwrap true } }
}

intent "ops.reconcile" {
  description "Nightly: find orders stuck between placed and fulfilled"
  response "response"
  timeout 60s
  node "stuck" {
    family database
    uses "database.query"
    resource "db"
    kind read
    provides [stuck]
    config {
      statement "SELECT id,status,created_at FROM orders WHERE status NOT IN ('fulfilled','rejected','cancelled') AND created_at < NOW() - INTERVAL '1 day' LIMIT 200"
      args []
    }
  }
  node "count" {
    family transform
    uses "data.count"
    requires [stuck]
    provides [stuck_count]
    config { source_fact "stuck" }
  }
  node "metric" {
    family metric
    uses "metric.emit"
    requires [stuck_count]
    provides [emitted]
    config { name "orders_stuck" kind gauge value_fact "stuck_count" }
  }
  node "response" { family response uses "collect" requires [stuck_count, emitted] provides [response] }
}

intent "payment.settled" {
  description "What the payment webhook delivers. It only records; the run is woken by the trigger itself."
  response "response"
  node "record" {
    family database
    uses "database.exec"
    resource "db"
    kind effect
    requires [input]
    provides [recorded]
    config {
      statement "UPDATE orders SET payment_ref=$2, updated_at=NOW() WHERE id=$1"
      args [input.order_id, input.reference]
    }
  }
  node "response" { family response uses "collect" requires [recorded] provides [response] }
}

####################################################################
# The durable fulfilment process
#
# This is what a request cannot do. It reserves stock, routes on
# value, waits — possibly for two days — for a person to approve,
# charges, fulfils and invoices in parallel, and if anything fails
# after the charge it refunds and releases the hold in reverse order.
#
# A deploy, a crash or a replica rescheduling in the middle of any of
# that changes nothing: the run is a row, and whichever replica picks
# it up next continues from its persisted cursor.
####################################################################

process "order.fulfil" {
  description "Reserve, approve, charge, fulfil, invoice — with a saga rollback"
  store "runs"
  queue "jobs"
  start "reserve"
  version 1
  migration_policy pin

  timeout 72h
  max_steps 100
  idempotency "id"
  retention 720h

  retry { max_attempts 3 strategy exponential initial_delay 500ms max_delay 30s jitter true }

  sla {
    target 4h
    breach 24h
    on_breach escalate
    escalate "admin"
  }

  # -- steps --------------------------------------------------------

  step "reserve" {
    description "Hold the stock. Compensated by releasing it."
    intent "inventory.reserve"
    compensate "inventory.release"
    family database
    timeout 30s
    # The lock is what stops two replicas reserving the same order
    # concurrently after a retry.
    lock "locks"
    lock_key "'order:' + run.input.id"
    lock_ttl 30s
  }

  step "approve" {
    description "A person decides. The run parks here until they do."
    family approval
    task {
      title "Approve order {{ run.input.id }}"
      instructions "This order is over the automatic approval limit. Approve or reject it."
      role "approver"
      actions [approve, reject]
      form_schema "ApprovalDecision"
      priority 5
      due 48h
      reminder 12h
      escalate "admin"
      allow_reassign true
      # Four eyes: whoever placed the order cannot approve it.
      forbid_principals ["run.input.customer_id"]
    }
  }

  step "record_approval" { intent "order.mark_approved" family database }
  step "record_rejection" { intent "order.mark_rejected" family database terminal true }

  step "charge" {
    description "Take the money. Compensated by refunding it."
    intent "payment.charge"
    compensate "payment.refund"
    family http
    timeout 45s
    retry { max_attempts 5 strategy exponential_jitter initial_delay 1s max_delay 60s }
  }

  step "fulfil"  { intent "order.fulfil_shipment" family database }
  step "notify"  { intent "order.notify" family notification }
  step "invoice" { intent "order.invoice" family storage terminal true }

  # -- edges --------------------------------------------------------
  #
  # Every edge evaluates its condition before it traverses, whatever
  # its kind. BCL reserves `when` as a parser keyword, so the guard is
  # always spelled `condition`.

  edge "small-order" {
    kind branch
    from "reserve"
    to "charge"
    condition "result.input.total_cents <= 50000"
  }

  edge "large-order" {
    kind branch
    from "reserve"
    to "approve"
    condition "result.input.total_cents > 50000"
  }

  edge "approved" {
    kind branch
    from "approve"
    to "record_approval"
    condition "result.action == 'approve'"
  }

  edge "rejected" {
    kind branch
    from "approve"
    to "record_rejection"
    condition "result.action == 'reject'"
  }

  edge "approved-charge" {
    kind simple
    from "record_approval"
    to "charge"
  }

  # After the charge, fulfilment and notification run concurrently and
  # the invoice waits for both.
  edge "after-charge" {
    kind fanout
    from "charge"
    targets [fulfil, notify]
  }

  edge "both-done" {
    kind fanin
    sources [fulfil, notify]
    to "invoice"
    strategy all
  }

  # Anything that fails after the charge rolls the whole thing back:
  # refund, then release the hold, newest first.
  edge "charge-failed" {
    kind compensate
    from "charge"
    to "invoice"
  }
}

####################################################################
# Workers, schedules and triggers
####################################################################

worker "notifications" {
  queue "jobs"
  job_type "order.notification"
  intent "notification.deliver"
  max_attempts 5
}

schedule "nightly-reconciliation" {
  cron "0 2 * * *"
  timezone "Europe/London"
  queue "jobs"
  intent "ops.reconcile"
  jitter 5m
}

trigger "payment-webhook" {
  kind webhook
  path "/webhooks/payment"
  secret "webhook_secret"
  signature_header "X-Payment-Signature"
  timestamp_header "X-Payment-Timestamp"
  tolerance 5m
  correlation_path "order_id"
  event "payment.settled"
}

####################################################################
# HTTP
#
# Everything a route declares is enforced before dispatch and fails
# closed: no identity means no authorization, an unreachable limiter
# means a refused request, an unresolvable tenant means a refusal
# rather than an unscoped query.
####################################################################

route "auth.register" {
  method POST
  path "/auth/register"
  intent "auth.register"
  session "sessions"
  status 201
  cache_control "no-store"
  rate_limit { limiter "limits" limit 5 window 1h }
  route_audit { action "auth.register" }
}

route "auth.login" {
  method POST
  path "/auth/login"
  intent "auth.login"
  session "sessions"
  cache_control "no-store"
  # Keyed on the remote address, because there is no principal yet.
  rate_limit { limiter "limits" limit 10 window 15m }
  route_audit { action "auth.login" }
}

route "auth.logout" {
  method POST
  path "/auth/logout"
  intent "auth.logout"
  session "sessions"
  cache_control "no-store"
}

route "auth.token" {
  method POST
  path "/auth/token"
  intent "auth.token"
  session "sessions"
  cache_control "no-store"
  rate_limit { limiter "limits" limit 20 window 1h }
}

route "catalogue.list" {
  method GET
  path "/catalogue"
  intent "catalogue.list"
  cache_control "public, max-age=30"
}

route "catalogue.upsert" {
  method PUT
  path "/catalogue"
  intent "catalogue.upsert"
  auth "identity"
  session "sessions"
  authz { permissions [catalogue:write] }
  cache_control "no-store"
  route_audit { action "catalogue.upsert" include_request true }
}

route "order.place" {
  method POST
  path "/orders"
  intent "order.place"
  auth "identity"
  session "sessions"
  status 201
  cache_control "no-store"
  max_body_bytes 65536
  timeout 15s
  authz { permissions [order:create] }
  rate_limit { limiter "limits" limit 30 window 1m }
  route_audit { action "order.place" include_request true redact [items] }
}

route "order.list" {
  method GET
  path "/orders"
  intent "order.list"
  auth "identity"
  session "sessions"
  cache_control "private, no-store"
}

route "order.get" {
  method GET
  path "/orders/:id"
  intent "order.get"
  auth "identity"
  session "sessions"
  cache_control "private, no-store"
}

route "tasks.list" {
  method GET
  path "/tasks"
  intent "task.list"
  auth "identity"
  session "sessions"
  cache_control "private, no-store"
}

route "tasks.decide" {
  method POST
  path "/tasks/:id/decide"
  intent "task.decide"
  auth "identity"
  session "sessions"
  authz { permissions [order:approve] }
  cache_control "no-store"
  route_audit { action "order.approval" include_request true }
}

route "ops.runs" {
  method GET
  path "/ops/runs"
  intent "order.runs"
  auth "identity"
  session "sessions"
  authz { permissions [process:read] }
  cache_control "no-store"
}
